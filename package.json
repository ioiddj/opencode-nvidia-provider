{
  "name": "opencode-nvidia-provider",
  "version": "0.1.0",
  "description": "OpenCode V2 plugin with configurable retry and backoff handling for NVIDIA NIM provider failures.",
  "type": "module",
  "main": "index.ts",
  "license": "MIT",
  "author": "ioiddj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ioiddj/opencode-nvidia-provider.git"
  },
  "homepage": "https://github.com/ioiddj/opencode-nvidia-provider#readme",
  "bugs": {
    "url": "https://github.com/ioiddj/opencode-nvidia-provider/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "nvidia",
    "nim",
    "rate-limit",
    "retry"
  ],
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "test:mutations": "node --experimental-strip-types --no-warnings scripts/mutation-check.ts",
    "test:runtime": "npm run test:runtime:plugin && npm run test:runtime:control",
    "test:runtime:plugin": "node --experimental-strip-types --no-warnings scripts/runtime-smoke.ts",
    "test:runtime:control": "node --experimental-strip-types --no-warnings scripts/runtime-control.ts",
    "verify:published-install": "node --experimental-strip-types --no-warnings scripts/verify-published-install.ts",
    "verify:published-install:control": "node --experimental-strip-types --no-warnings scripts/verify-published-install-control.ts",
    "publish:tree": "node --experimental-strip-types --no-warnings scripts/publish-tree.ts",
    "publish:check": "node --experimental-strip-types --no-warnings scripts/publish-tree.ts --check",
    "publish:rebuild": "node --experimental-strip-types --no-warnings scripts/rebuild-branch.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {},
  "devDependencies": {
    "@opencode/plugin": "2.1.4",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
